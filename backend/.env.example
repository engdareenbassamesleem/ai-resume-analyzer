# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# API Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Or use alternative AI service
AI_SERVICE=openai

# File Upload Settings
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=pdf

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
